 0.033 256.848)","borderTopStyle":"solid","fontSize":"24px","fontWeight":"700","lineHeight":"32px","display":"block","flexDirection":"row","justifyContent":"normal","alignItems":"normal","WebkitTextFillColor":"oklch(0.278 0.033 256.848)","fontFamily":"Inter, sans-serif","letterSpacing":"normal","textAlign":"start","textTransform":"none","fontStyle":"normal"},"tr":[48,3496.8,400.2,29,1],"text":"La hipótesis que se quedaba corta","runs":[{"t":"La hipótesis que se quedaba corta","s":{"color":"oklch(0.278 0.033 256.848)","fontWeight":"700","fontStyle":"normal","fontSize":"24px","fontFamily":"Inter, sans-serif","letterSpacing":"normal","textTransform":"none"}}]},{"t":"p","x":48,"y":3539.8,"w":672,"h":104,"cls":"text-gray-600 dark:text-gray-300 max-w-2xl leading-relaxed","s":{"color":"oklch(0.446 0.03 256.802)","borderTopStyle":"solid","lineHeight":"26px","display":"block","flexDirection":"row","justifyContent":"normal","alignItems":"normal","WebkitTextFillColor":"oklch(0.446 0.03 256.802)","fontFamily":"Inter, sans-serif","fontSize":"16px","fontWeight":"400","letterSpacing":"normal","textAlign":"start","textTransform":"none","fontStyle":"normal"},"tr":[48,3542.8,661,98,4],"text":"La hipótesis inicial era la típica: la gente no controla sus finanzas porque las apps que existen son muy complejas, muy frías, o no generan hábito. Después de hablar con tres personas reales (Rossana, Gabriel y María) quedó claro que esa hipótesis, aunque no estaba mal, se quedaba corta.","runs":[{"t":"La hipótesis inicial era la típica: la gente no controla sus finanzas porque las apps que existen son muy complejas, muy frías, o no generan hábito. Después de hablar con tres personas reales (Rossana, Gabriel y María) quedó claro que esa hipótesis, aunque no estaba mal, se quedaba corta.","s":{"color":"oklch(0.446 0.03 256.802)","fontWeight":"400","fontStyle":"normal","fontSize":"16px","fontFamily":"Inter, sans-serif","letterSpacing":"normal","textTransform":"none"}}]},{"t":"p","x":48,"y":3655.8