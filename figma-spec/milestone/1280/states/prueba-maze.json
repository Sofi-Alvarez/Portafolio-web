3 256.848)","borderTopStyle":"solid","fontSize":"24px","fontWeight":"700","lineHeight":"32px","display":"block","flexDirection":"row","justifyContent":"normal","alignItems":"normal","WebkitTextFillColor":"oklch(0.278 0.033 256.848)","fontFamily":"Inter, sans-serif","letterSpacing":"normal","textAlign":"start","textTransform":"none","fontStyle":"normal"},"tr":[48,9242.4,363.3,29,1],"text":"Dos estudios complementarios","runs":[{"t":"Dos estudios complementarios","s":{"color":"oklch(0.278 0.033 256.848)","fontWeight":"700","fontStyle":"normal","fontSize":"24px","fontFamily":"Inter, sans-serif","letterSpacing":"normal","textTransform":"none"}}]},{"t":"p","x":48,"y":9285.4,"w":672,"h":182,"cls":"text-gray-600 dark:text-gray-300 max-w-2xl leading-relaxed","s":{"color":"oklch(0.446 0.03 256.802)","borderTopStyle":"solid","lineHeight":"26px","display":"block","flexDirection":"row","justifyContent":"normal","alignItems":"normal","WebkitTextFillColor":"oklch(0.446 0.03 256.802)","fontFamily":"Inter, sans-serif","fontSize":"16px","fontWeight":"400","letterSpacing":"normal","textAlign":"start","textTransform":"none","fontStyle":"normal"},"tr":[48,9288.4,671.4,176,7],"text":"El plan de testing se armó como dos estudios complementarios: un test no moderado en Maze sobre el registro diario de gastos e ingresos, y cinco sesiones moderadas 1:1 sobre Metas, el flujo con más componentes y jerarquía visual del producto. Los resultados validaron la apuesta (6.55/7 de facilidad percibida en Metas, 88.9% de éxito en el registro diario sin ayuda y 17 de 20 tareas resueltas de forma directa o con ayuda mínima), pero lo más valioso no fueron los números, sino lo que las sesiones moderadas destaparon.","runs":[{"t":"El plan de testing se armó como dos estudios complementarios: un test no moderado en Maze sobre el registro diario de gastos e ingresos, y cinco sesiones moderadas 1:1 sobre Metas, el flujo con más componentes y jerarquía visual del producto. Los resultados validaron la apuesta (6.55/7 de facilidad percibida en Metas, 88.9% de éxito en el registro diario sin ayuda y 17 de 20 tareas resueltas de forma directa o con ayuda mínima), pero lo más valioso no fueron los números, sino lo que las sesiones moderadas destaparon.","s":{"color":"oklch(0.446 0.03 256.802)","fontWeight":"400","fontStyle":"normal","fontSize":"16px","fontFamily":"Inter, sans-serif","letterSpacing":"normal","textTransform":"none"}}]},{"t":"p","x":48,"y":9479.4,"w":672,"h":208,"cls":"text-gray-600 dark:text-gray-300 max-w-2xl leading-relaxed mt-3","s":{"color":"oklch(0.446 0.03 256.802)","borderTopStyle":"solid","lineHeight":"26px","display":"block","flexDirection":"row","justifyContent":"normal","alignItems":"normal","WebkitTextFillColor":"oklch(0.446 0.03 256.802)","fontFamily":"Inter, sans-serif","fontSize":"16px","fontWeight":"400","letterSpacing":"normal","textAlign":"start","textTransform":"none","fontStyle":"normal"},"tr":[48,9482.4,663.8,202,8],"text":"Ahí apareció el hallazgo crítico del proyecto: una meta de $20.000 se marcaba como \"lograda\" tras un aporte de solo $5.000, un bug de integridad de datos que hubiera validado exactamente la desconfianza que todo el research había identificado como el enemigo del hábito. Cada hallazgo pasó por severidad, fix y deploy: 9 fixes a producción, cada uno verificado con flutter analyze y flutter build web antes de publicarse. Entre ellos, faltaba la meta viewport y los celulares reales mostraban el mockup de escritorio, el botón \"+\" de la barra solo respondía en la mitad de su círculo y los formularios no mostraban errores de validación.","runs":[{"t":"Ahí apareció el hallazgo crítico del proyecto: una meta de $20.000 se marcaba como \"lograda\" tras un aporte de solo $5.000, un bug de integridad de datos que hubiera validado exactamente la desconfianza que todo el research había identificado como el enemigo del hábito. Cada hallazgo pasó por severidad, fix y deploy: 9 fixes a producción, cada uno verificado con flutter anal